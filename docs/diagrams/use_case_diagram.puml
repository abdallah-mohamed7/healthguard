@startuml
left to right direction
skinparam packageStyle rectangle

actor "Patient / User" as User
actor "Medical Admin" as Admin
actor "AI & OCR Engine" as AI

rectangle "HealthGuard Platform" {
  usecase "Authenticate & Profile Setup" as UC1
  usecase "Upload Lab Report (PDF/Image)" as UC2
  usecase "Extract Lab Metrics (OCR)" as UC3
  usecase "Review & Confirm Extracted Data" as UC4
  usecase "View Longitudinal Trends & Flags" as UC5
  usecase "Query AI Assistant (Grounded Triage)" as UC6
  usecase "Receive Screening Reminders" as UC7
  usecase "Manage Reference Rules & Thresholds" as UC8
}

User --> UC1
User --> UC2
User --> UC4
User --> UC5
User --> UC6
User --> UC7

UC2 .> UC3 : <<include>>
AI --> UC3
AI --> UC6

Admin --> UC8
Admin --> UC1
@enduml
